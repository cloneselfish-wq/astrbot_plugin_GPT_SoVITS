{
    "enabled": {
        "description": "总开关",
        "type": "bool",
        "hint": "GPT-SoVITS 插件总开关，请在部署好 GPT-SoVITS 后再打开此开关",
        "default": true
    },
    "auto": {
        "description": "回复转语音配置",
        "type": "object",
        "hint": "机器人自己的对话回复（LLM 结果）会在发送前被转成语音发出去；图片、@ 等非文本内容原样保留。注意：一个 GPT-SoVITS 实例同一时间只能常驻一套音色，多音色请配合下方的「音色档案」使用",
        "items": {
            "only_llm_result": {
                "description": "只处理LLM结果",
                "type": "bool",
                "hint": "只处理 LLM 返回的对话回复，指令类回复（如 /help）保持文字。建议打开",
                "default": true
            },
            "tts_prob": {
                "description": "回复转语音的概率",
                "type": "float",
                "hint": "1.0 = 机器人每一条回复都转成语音；0.1 = 只有约 10% 的回复转语音，其余发文字。合成是同步等待（耗时为音频时长的 2 倍），比例过高会显著拖慢回复；想让机器人「想说话时才说话」，保持较低概率并依赖 gsv_tts 工具即可",
                "slider": {
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                },
                "default": 0.1
            },
            "max_msg_len": {
                "description": "转语音的长度上限",
                "type": "int",
                "hint": "超过此长度的回复不转语音，直接发文字。文字越长合成越慢（本机实测合成耗时约为音频时长的 2 倍），建议 100~150",
                "slider": {
                    "min": 0,
                    "max": 500,
                    "step": 1
                },
                "default": 150
            },
            "dual_output": {
                "description": "语音与文字同时发送",
                "type": "bool",
                "hint": "关闭时只发语音；打开后同一条回复会先发语音、再发一遍文字，方便没开声音时阅读。合成速度不变（两条是一起发出的）",
                "default": false
            },
            "only_configured_bots": {
                "description": "只给配置了音色的机器人转语音",
                "type": "bool",
                "hint": "打开后，没有命中「音色档案」的机器人不会转语音，直接发文字——否则它会借用全局配置（客户端地址 + 模型配置 + TTS 默认参数）里的音色说话，听起来像是替别的角色开口。关闭则保持旧行为（未命中的回退到全局配置）。注意：一条音色档案都没配置时本项不生效，否则整个插件都不出声",
                "default": false
            },
            "voice_on_request": {
                "description": "群友点名要语音时必须发语音",
                "type": "bool",
                "hint": "打开后，群友明确要求「说句话 / 用语音说 / 念一下 / 唱一句」时会跳过上面的概率，直接转成语音。关掉则一切回复都只看概率。说明：这里的识别只在短消息里生效（30 字以内），且会拦掉否定式（如「别用语音」「文字就好」）；长文里的「语音」不算要求",
                "default": true
            },
            "zh_text_on_foreign_voice": {
                "description": "外语语音后面附上中文原文",
                "type": "bool",
                "hint": "日语音色（开了「合成前翻译」）说出来的语音，群友听不出口音里的中文内容。打开后，这类语音后面会自动跟上送合成前的那份中文原文。只在「语音语言不是中文」且「原文本身是中文」时才附；说中文的语音不会重复发文字。与上面的「语音与文字同时发送」不叠加（那个已经会附全文）",
                "default": true
            }
        }
    },
    "client": {
        "description": "客户端配置",
        "type": "object",
        "hint": "",
        "items": {
            "base_url": {
                "description": "GPT-SoVITS API 的 URL",
                "type": "string",
                "hint": "必填！GPT_SoVITS官方整合包默认为 http://127.0.0.1:9880 ，第三方整合包可能不同",
                "default": "http://127.0.0.1:9880"
            },
            "timeout": {
                "description": "GPT-SoVITS API 请求超时时间",
                "hint": "单位为秒",
                "type": "int",
                "slider": {
                    "min": 30,
                    "max": 180,
                    "step": 1
                },
                "default": 60
            }
        }
    },
    "bot_voices": {
        "description": "音色档案（给不同的机器人分配不同音色）",
        "hint": "按机器人的 QQ 号匹配。命中档案后，会用该档案的实例地址、模型权重和参考音频来合成语音；没有命中的机器人仍走上面的全局配置。注意：一个 GPT-SoVITS 实例同一时间只能常驻一套音色，要给两个机器人配不同音色，需要在本机分别启动两个实例（例如 9880 与 9881）。",
        "type": "template_list",
        "templates": {
            "default": {
                "name": "音色档案",
                "items": {
                    "name": {
                        "description": "音色名称",
                        "type": "string",
                        "hint": "仅用于显示与日志，例如「刻晴」",
                        "default": ""
                    },
                    "self_id": {
                        "description": "机器人 QQ 号",
                        "type": "string",
                        "hint": "该音色对应的机器人账号。多个账号可用英文逗号分隔",
                        "default": ""
                    },
                    "enabled": {
                        "description": "启用此档案",
                        "type": "bool",
                        "hint": "关闭后此机器人回退到全局配置",
                        "default": true
                    },
                    "base_url": {
                        "description": "该音色的实例地址",
                        "type": "string",
                        "hint": "留空则使用全局的客户端地址。不同音色请指向不同的端口",
                        "default": ""
                    },
                    "gpt_path": {
                        "description": "GPT 模型文件路径(.ckpt)",
                        "type": "string",
                        "hint": "必须是运行的 GPT-SoVITS 所在机器上的路径，请用 “/” 分隔。留空则用全局配置",
                        "default": ""
                    },
                    "sovits_path": {
                        "description": "SoVITS 模型文件路径(.pth)",
                        "type": "string",
                        "hint": "必须是运行的 GPT-SoVITS 所在机器上的路径，请用 “/” 分隔。留空则用全局配置",
                        "default": ""
                    },
                    "ref_audio_path": {
                        "description": "参考音频路径",
                        "type": "string",
                        "hint": "决定音色，必须是运行的 GPT-SoVITS 所在机器上的路径。3~10 秒的纯净人声效果最好",
                        "default": ""
                    },
                    "prompt_text": {
                        "description": "参考音频对应的文本",
                        "type": "string",
                        "hint": "需与参考音频内容逐字一致",
                        "default": ""
                    },
                    "prompt_lang": {
                        "description": "参考音频的语言",
                        "type": "string",
                        "hint": "参考音频讲什么语言就填什么。日文参考音频填 ja",
                        "options": [
                            "zh",
                            "en",
                            "ja",
                            "ko"
                        ],
                        "labels": [
                            "中文",
                            "英语",
                            "日语",
                            "韩语"
                        ],
                        "default": "zh"
                    },
                    "text_lang": {
                        "description": "合成文本的语言",
                        "type": "string",
                        "hint": "要合成的内容是什么语言。参考音频是日文也可以合成中文",
                        "options": [
                            "zh",
                            "en",
                            "ja",
                            "ko"
                        ],
                        "labels": [
                            "中文",
                            "英语",
                            "日语",
                            "韩语"
                        ],
                        "default": "zh"
                    },
                    "speed_factor": {
                        "description": "语速倍数",
                        "type": "float",
                        "hint": "1.0 为原速",
                        "slider": {
                            "min": 0.5,
                            "max": 2.0,
                            "step": 0.1
                        },
                        "default": 1
                    },
                    "fragment_interval": {
                        "description": "语音片段间隔（秒）",
                        "type": "float",
                        "hint": "间隔越短语气越急促",
                        "slider": {
                            "min": 0.1,
                            "max": 1.0,
                            "step": 0.01
                        },
                        "default": 0.3
                    },
                    "emotion_ref_audio": {
                        "description": "允许情绪条目覆盖参考音频",
                        "type": "bool",
                        "hint": "关闭时（推荐），情绪条目只影响语速和停顿，不会改变该机器人的音色；开启后情绪条目自带的参考音频会覆盖本档案的音色",
                        "default": false
                    },
                    "auto_translate": {
                        "description": "合成前翻译成「合成文本的语言」",
                        "type": "bool",
                        "hint": "开启后，若机器人回复的语言与上面的「合成文本的语言」不一致，先用 LLM 翻译过去再合成语音（只为母语音色服务，文字回复仍是原文）。例如日文音色：合成文本的语言选「日语」并打开本项",
                        "default": false
                    },
                    "translate_style": {
                        "description": "翻译口吻提示（可选）",
                        "type": "string",
                        "hint": "追加给翻译模型的人设，例如「活泼的年轻女性口语」。留空使用通用设定",
                        "default": ""
                    }
                }
            }
        }
    },
    "model": {
        "description": "模型配置",
        "type": "object",
        "hint": "",
        "items": {
            "gpt_path": {
                "description": "GPT模型文件路径",
                "type": "string",
                "hint": "即“.ckpt”后缀的文件。请使用 “/” 分隔路径，支持绝对路径和相对路径。请确保该文件与部署的GSV在同一台机子上。不填则默认用 GPT_SoVITS 内置 GPT 模型",
                "default": ""
            },
            "sovits_path": {
                "description": "SoVITS模型文件路径",
                "type": "string",
                "hint": "即“.pth”后缀的文件。请使用 “/” 分隔路径，支持绝对路径和相对路径。请确保该文件与部署的GSV在同一台机子上。不填则默认用 GPT_SoVITS 内置 SoVITS 模型",
                "default": ""
            },
            "manage_weights": {
                "description": "由插件设置权重",
                "type": "bool",
                "hint": "开启时，插件启动会把上面填的模型推给 GSV 实例（/set_gpt_weights、/set_sovits_weights）。若你的实例是用自己的 yaml（-c 参数）启动、权重本来就对，可关闭此项：省去一次重复加载，降低多实例共存时的显存/内存瞬时峰值。",
                "default": true
            }
        }
    },
    "default_params": {
        "description": "TTS默认参数",
        "type": "object",
        "hint": "这些参数将用于每次语音合成请求，可根据需要调整",
        "items": {
            "text": {
                "description": "要转换为语音的文本",
                "type": "string",
                "hint": "支持任意语言，但需与 text_lang 匹配",
                "default": "你要干嘛？"
            },
            "text_lang": {
                "description": "文本语言",
                "type": "string",
                "hint": "要转化的文本的语言",
                "options": [
                    "zh",
                    "en",
                    "ja",
                    "ko"
                ],
                "labels": [
                    "中文",
                    "英语",
                    "日语",
                    "韩语"
                ],
                "default": "zh"
            },
            "ref_audio_path": {
                "description": "参考音频路径",
                "type": "string",
                "hint": "用于音色克隆，请使用 “/” 分隔路径，支持 wav 格式，必填。请确保该文件与部署的GSV在同一台机子上。",
                "default": "data/plugins/astrbot_plugin_GPT_SoVITS/default_audio/就算是这样，也不至于直接碎掉啊，除非.wav"
            },
            "prompt_text": {
                "description": "参考音频对应的文本",
                "type": "string",
                "hint": "用于对齐音色与内容，建议填写",
                "default": "就算是这样，也不至于直接碎掉啊，除非"
            },
            "prompt_lang": {
                "description": "参考音频文本语言",
                "type": "string",
                "hint": "尽量与 prompt_text 语言一致",
                "options": [
                    "zh",
                    "en",
                    "ja",
                    "ko"
                ],
                "labels": [
                    "中文",
                    "英语",
                    "日语",
                    "韩语"
                ],
                "default": "zh"
            },
            "top_k": {
                "description": "Top-K 采样",
                "type": "int",
                "hint": "控制生成语音的多样性，值越大越多样",
                "slider": {
                    "min": 1,
                    "max": 20,
                    "step": 1
                },
                "default": 5
            },
            "top_p": {
                "description": "Top-P 核采样",
                "type": "float",
                "hint": "控制采样范围，1.0 表示不限制",
                "slider": {
                    "min": 0.1,
                    "max": 1.0,
                    "step": 0.01
                },
                "default": 1.0
            },
            "temperature": {
                "description": "采样温度",
                "type": "float",
                "hint": "控制随机性，1.0 为原始分布，越低越保守",
                "slider": {
                    "min": 0.1,
                    "max": 2.0,
                    "step": 0.01
                },
                "default": 1.0
            },
            "text_split_method": {
                "description": "文本切分方式",
                "type": "string",
                "hint": "影响长文本处理效果",
                "options": [
                    "cut0",
                    "cut1",
                    "cut2",
                    "cut3",
                    "cut4",
                    "cut5"
                ],
                "labels": [
                    "不切分",
                    "四句一切",
                    "50字一切",
                    "按中文句号切",
                    "按英文句号切",
                    "按标点符号切"
                ],
                "default": "cut3"
            },
            "batch_size": {
                "description": "推理批大小",
                "type": "int",
                "hint": "越大越快但越占显存",
                "slider": {
                    "min": 1,
                    "max": 5,
                    "step": 1
                },
                "default": 1
            },
            "batch_threshold": {
                "description": "批处理阈值",
                "type": "float",
                "hint": "控制是否拆分批次",
                "slider": {
                    "min": 0.1,
                    "max": 1.0,
                    "step": 0.01
                },
                "default": 0.75
            },
            "split_bucket": {
                "description": "启用分桶推理",
                "type": "bool",
                "hint": "开启后可并行处理长文本，建议开启",
                "default": true
            },
            "speed_factor": {
                "description": "语速倍数",
                "type": "float",
                "hint": "1.0 为原速",
                "slider": {
                    "min": 0.5,
                    "max": 2.0,
                    "step": 0.1
                },
                "default": 1.0
            },
            "fragment_interval": {
                "description": "语音片段间隔",
                "type": "float",
                "hint": "单位：秒，影响停顿感",
                "slider": {
                    "min": 0.1,
                    "max": 1.0,
                    "step": 0.01
                },
                "default": 0.3
            },
            "streaming_mode": {
                "description": "启用流式返回",
                "type": "bool",
                "hint": "开启后逐步返回音频流，适合长文本",
                "default": false
            },
            "seed": {
                "description": "随机种子",
                "type": "int",
                "hint": "-1 为随机，设定后可复现结果",
                "default": -1
            },
            "parallel_infer": {
                "description": "启用并行推理",
                "type": "bool",
                "hint": "开启后可提升速度，建议开启",
                "default": true
            },
            "repetition_penalty": {
                "description": "重复惩罚系数",
                "type": "float",
                "hint": "越高越不容易重复",
                "slider": {
                    "min": 1.0,
                    "max": 3.0,
                    "step": 0.01
                },
                "default": 1.35
            },
            "media_type": {
                "description": "输出音频格式",
                "type": "string",
                "hint": "建议 wav，兼容性好",
                "options": [
                    "wav",
                    "mp3",
                    "ogg"
                ],
                "default": "wav"
            }
        }
    },
    "judge": {
        "description": "LLM 配置",
        "hint": "",
        "type": "object",
        "items": {
            "enabled_llm": {
                "description": "使用 LLM 判断情感",
                "type": "bool",
                "hint": "开启后，将使用 LLM 模型判断当前文本的情绪，从而改变语音的情绪参数。若关闭， 则使用情绪条目的触发词来匹配情绪",
                "default": false
            },
            "provider_id": {
                "description": "判断情感用的LLM提供商",
                "type": "string",
                "default": "",
                "hint": "留空或者填写的提供商不存在时, 则使用当前正在使用的LLM提供商。 tip:工作较为简单，建议用稳定便宜又快速的小模型",
                "_special": "select_provider"
            }
        }
    },
    "translate": {
        "description": "语音翻译配置",
        "hint": "当某个音色档案开启了「合成前翻译」时生效：机器人回复会先被 LLM 翻译成该档案「合成文本的语言」再送去合成，文字回复本身不受影响。翻译会增加一次 LLM 调用的耗时，建议指定一个稳定快速的小模型。",
        "type": "object",
        "items": {
            "provider_id": {
                "description": "翻译用的LLM提供商",
                "type": "string",
                "default": "",
                "hint": "留空则沿用「LLM 配置」里的提供商，再留空则使用当前默认提供商",
                "_special": "select_provider"
            },
            "allow_switch": {
                "description": "允许群友点播语音语言",
                "type": "bool",
                "default": true,
                "hint": "默认按音色档案的语言发音（日语音色就说日语）。打开后，群友说「说中文」「用中文说」这类要求时会临时切到中文；另有「语音语言」指令可手动切换。只对开了「合成前翻译」的音色生效。"
            },
            "switch_ttl_minutes": {
                "description": "语言切换记住多久(分钟)",
                "type": "int",
                "default": 10,
                "hint": "被点名换语言后，会话内保持该语言的时间。填 0 表示只在被点名的那一次生效，不记住。"
            }
        }
    },
    "cache": {
        "description": "缓存配置",
        "type": "object",
        "hint": "",
        "items": {
            "enabled": {
                "description": "启用语音缓存",
                "hint": "开启后，请求参数一致时直接复用本地缓存音频，减少重复推理",
                "type": "bool",
                "default": true
            },
            "expire_hours": {
                "description": "缓存过期时间(h)",
                "hint": "单位为小时。 0 表示永不过期，大于 0 时按文件修改时间判断是否过期",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 240,
                    "step": 1
                },
                "default": 0
            },
            "path": {
                "description": "缓存路径",
                "hint": "请使用 “/” 分隔路径，支持绝对路径和相对路径；留空时默认 data/plugin_data/astrbot_plugin_GPT_SoVITS/audio",
                "type": "string",
                "default": "data/plugin_data/astrbot_plugin_GPT_SoVITS/audio"
            }
        }
    },
    "entry_storage": {
        "description": "情绪参数配置",
        "hint": "可自定义多套情绪参数，并定义对应触发词。由此实现不同情绪的语音",
        "type": "template_list",
        "templates": {
            "default": {
                "name": "情绪条目",
                "items": {
                    "name": {
                        "description": "情绪名",
                        "type": "string",
                        "hint": "用于查询与显示，请确保名称唯一",
                        "default": "请输入情绪名"
                    },
                    "keywords": {
                        "description": "触发词",
                        "type": "list",
                        "hint": "AI回复词中含有列表中的任一关键词时, 将使用此套的情绪参数",
                        "default": []
                    },
                    "ref_audio_path": {
                        "description": "参考音频文件路径",
                        "type": "string",
